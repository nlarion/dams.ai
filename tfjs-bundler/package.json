{
  "name": "dams-tfjs-bundler",
  "version": "2.0.0",
  "description": "TensorFlow.js bundler for DAMS.AI Chrome extension - CNN image classification",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "build": "webpack build --config webpack.config.js",
    "build:legacy": "export NODE_OPTIONS=--openssl-legacy-provider && webpack build --config webpack.config.js"
  },
  "keywords": ["tensorflow", "tfjs", "cnn", "image-classification", "ad-detection"],
  "author": "DAMS.AI",
  "license": "ISC",
  "devDependencies": {
    "file-loader": "^5.0.2",
    "webpack": "^5.4.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "3.11.2"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0"
  }
}
